# ── Обязательные ──────────────────────────────────────────────────────────────

# Токен бота от @BotFather
BOT_TOKEN=your_telegram_bot_token

# Нужен хотя бы один ключ нейросети. Задано оба — GigaChat основной,
# Mistral подхватывает, если GigaChat не ответил.

# GigaChat (Сбер) — «Ключ авторизации» из личного кабинета
# https://developers.sber.ru/studio → проект GigaChat API → Настройки API.
# Бесплатный тариф для физлиц, карта не нужна, работает с российских серверов.
GIGACHAT_CREDENTIALS=your_gigachat_authorization_key

# Ключ Mistral AI — https://console.mistral.ai (запасной)
MISTRAL_API_KEY=your_mistral_api_key


# ── Нейросети: тонкая настройка (менять не обязательно) ───────────────────────

# Порядок провайдеров: первый — основной, остальные — запасные
# LLM_PROVIDERS=gigachat,mistral

# GIGACHAT_SCOPE=GIGACHAT_API_PERS      # для юрлиц: GIGACHAT_API_CORP / _B2B
# GIGACHAT_MODEL=GigaChat-2-Max         # личные ДЗ: текст и фото
# GIGACHAT_FAST_MODEL=GigaChat-2        # сообщения чата класса (только текст)
# GIGACHAT_VISION_MODEL=GigaChat-2-Pro  # фото в чате класса
# Корневой сертификат Минцифры — без него TLS к GigaChat не проверяется.
# В репозитории уже лежит certs/russian_trusted_root_ca.pem.
# GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca.pem

# На бесплатном тарифе Mistral работает только ministral-14b-latest:
# у mistral-small/medium лимит запросов 0.
# MISTRAL_MODEL=ministral-14b-latest


# ── Время ─────────────────────────────────────────────────────────────────────

# Часовой пояс школы: от него считаются «сегодня», «завтра» и напоминания.
# Сервер обычно живёт в UTC, поэтому задавать обязательно.
TIMEZONE=Europe/Moscow


# ── Google Calendar (необязательно, из меню убран) ────────────────────────────

# credentials.json приложения — общий для всех пользователей.
# Можно положить файлом в data/ или передать содержимое этой переменной.
# GOOGLE_CREDENTIALS_JSON=

# Токен доступа выдаётся каждому пользователю отдельно (команда /auth)
# и хранится в БД. GOOGLE_TOKEN_JSON поддерживается только для переноса
# старого общего токена — он будет записан администратору из ADMIN_USER_ID.
# GOOGLE_TOKEN_JSON=


# ── WebApp (Telegram Mini App) ────────────────────────────────────────────────

# URL задеплоенного Next.js webapp.
# Если задан — в клавиатуре появляется кнопка «Открыть приложение».
# Также используется как разрешённый CORS Origin для REST API.
WEB_APP_URL=https://your-webapp.example.com

# ID Telegram-группы класса — для установки, обслуживающей один класс.
# Задания из webapp привязываются к этой группе и видны в ней.
# Если не задан, класс определяется по данным пользователя, поэтому один
# бот может обслуживать несколько классов.
WEBAPP_CHAT_ID=


# ── Прочее ────────────────────────────────────────────────────────────────────

# Telegram ID администратора (узнать у @userinfobot).
# Получает резервные копии расписания в личные сообщения.
ADMIN_USER_ID=123456789

# Каталог данных. По умолчанию: /data если существует, иначе ./data
# DATA_DIR=/data

# Резервная копия расписания — восстанавливается автоматически при пустой БД.
# Значение выдаёт команда /backup.
# SCHEDULE_BACKUP=

# ⚠️ ТОЛЬКО для локальной разработки без Telegram-клиента.
# Отключает проверку подписи initData — REST API начнёт верить
# любому user_id из заголовка X-Debug-User-Id. В проде не включать.
# ALLOW_UNSIGNED_WEBAPP=0
